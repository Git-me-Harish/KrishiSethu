# KrishiSetu API — Environment Configuration
# Copy to .env and fill in real values

# Environment
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://krishisetu:krishisetu_dev_password@localhost:5432/krishisetu
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Redis
REDIS_URL=redis://localhost:6379/0

# Security — CHANGE THESE IN PRODUCTION
JWT_SECRET=change-me-to-a-256-bit-random-secret-please-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_BCRYPT_ROUNDS=12

# Object Storage (MinIO in dev, S3 in prod)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=krishisetu
S3_SECRET_KEY=krishisetu_dev_password
S3_BUCKET_NAME=krishisetu
S3_REGION=ap-south-1

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Rate Limiting
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_ML=20/minute

External APIs (fill when integrating)
IMD_API_KEY=
OPENWEATHERMAP_API_KEY=
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
UIDAI_API_KEY=
UIDAI_API_URL=https://api.uidai.gov.in
MSG91_AUTH_KEY=
FCM_SERVER_KEY=

# ML Inference Service
ML_INFERENCE_URL=http://localhost:8001

# Payment Gateway (Razorpay)
# Get keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_XXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXX
KRISHISETU_UPI_VPA=krishisetu@razorpay

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=krishisetu-api
