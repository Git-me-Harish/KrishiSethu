# KrishiSetu API — Environment Configuration
# Environment
ENV=development
DEBUG=true
LOG_LEVEL=INFO


# Database
DATABASE_URL=postgresql+asyncpg://krishisetu:krishisetu_dev_password@localhost:5432/krishisetu
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800


# Redis
REDIS_URL=redis://localhost:6379/0


# Security — PRODUCTION-REQUIRED
# Generate with:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-256-bit-random-secret-please-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_BCRYPT_ROUNDS=12

# Field-level encryption key (AES-256-GCM) — PRODUCTION-REQUIRED
# Generate with:  python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=
# Previous keys (for rotation). Accepts JSON array or comma-separated list.
# Example: ENCRYPTION_KEY_PREVIOUS=["old-key-base64","older-key-base64"]
ENCRYPTION_KEY_PREVIOUS=
# CSRF double-submit signing secret — PRODUCTION-REQUIRED (min 32 chars)
# Generate with:  openssl rand -hex 32
CSRF_SECRET=


# Object Storage (MinIO in dev, S3 in prod)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=krishisetu
S3_SECRET_KEY=krishisetu_dev_password
S3_BUCKET_NAME=krishisetu
S3_REGION=ap-south-1


# CORS & Frontend
CORS_ORIGINS=["http://localhost:3000"]
FRONTEND_URL=http://localhost:3000


# Rate Limiting
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_ML=20/minute


# Google OAuth (optional in dev, PRODUCTION-REQUIRED if client ID is set)
# Register in Google Cloud Console → Credentials → OAuth 2.0 Client IDs.
# Add the redirect URI below to "Authorized redirect URIs" in GCC.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback


# External APIs (fill when integrating; all optional in dev)
IMD_API_KEY=
OPENWEATHERMAP_API_KEY=
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
UIDAI_API_KEY=
UIDAI_API_URL=https://api.uidai.gov.in
MSG91_AUTH_KEY=
FCM_SERVER_KEY=


# ML Inference Service
ML_INFERENCE_URL=http://localhost:8001


# Payment Gateway (Razorpay)
# Get keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_XXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXX
KRISHISETU_UPI_VPA=krishisetu@razorpay


# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=krishisetu-api


# Content Security Policy (Phase F security hardening)
# Leave empty to use the strict default policy baked into security_headers.py.
CSP_DIRECTIVES=
CSP_REPORT_ONLY=false

# Maximum request body size in bytes (default 15 MB).
MAX_REQUEST_BODY_BYTES=15728640


# DPDP Compliance — PRODUCTION-REQUIRED
# Data retention period (days) for inactive accounts. DPDP default: 2555 (7 yrs).
DPDP_DATA_RETENTION_DAYS=2555
# Grievance Officer email — REQUIRED in production (DPDP Act 2023, Section 7).
DPDP_GRIEVANCE_OFFICER_EMAIL=
# SLA for grievance resolution (DPDP mandates 30 days).
DPDP_GRIEVANCE_RESOLUTION_DAYS=30


# Antivirus scan endpoint (optional, for file uploads)
# Example: tcp://clamav:3310  (see docker-compose.yml clamav service)
AV_SCAN_URL=