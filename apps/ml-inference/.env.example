# KrishiSetu ML Inference Service — Environment Configuration

ENV=development
LOG_LEVEL=INFO

# Server
ML_HOST=0.0.0.0
ML_PORT=8001

# Service-to-service auth (REQUIRED — the service will not start without it).
# Callers must present this value in the X-ML-Service-Token header on every
# /predict/* and /voice/* request. /health is exempt so container healthchecks
# keep working. Must match ML_SERVICE_TOKEN in apps/api.
# Generate with: openssl rand -hex 32
ML_SERVICE_TOKEN=

# Object Storage (for model artifacts)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=krishisetu
S3_SECRET_KEY=krishisetu_dev_password
S3_BUCKET_NAME=krishisetu-models
S3_REGION=ap-south-1

# Model paths (local file system or S3 URI)
# Format: model_name=path
# Local: /app/models/disease_classifier_v1.onnx
# S3:    s3://krishisetu-models/disease/v1.onnx
DISEASE_CLASSIFIER_MODEL_PATH=/app/models/disease_classifier_dummy.onnx
DISEASE_CLASSIFIER_MODEL_VERSION=v0.1.0-dummy

# Model labels (comma-separated, must match training)
# For the dummy model, we use a small subset for testing
DISEASE_CLASSIFIER_LABELS=healthy,tomato_early_blight,tomato_late_blight,rice_blast,rice_bacterial_blight,wheat_rust

# Inference
MODEL_WARMUP_ON_START=true
MAX_IMAGE_SIZE_MB=10
INFERENCE_TIMEOUT_SECONDS=30

# CORS is intentionally NOT configured: this service is internal and is only
# ever called by apps/api over the private network, never from a browser.
