# KrishiSetu Root Environment
# Copy to .env and adjust as needed.
#
# This file is read by docker-compose (infra/docker-compose.yml) and by the
# Makefile / scripts at the repo root. It does NOT replace apps/api/.env —
# the API's own .env holds the full app configuration.
#
# In DEVELOPMENT: the defaults below work out of the box.
# In PRODUCTION:  change every password and secret to a real value, and the
#                 API's config.py validator will refuse to boot if you forget.

ENV=development
LOG_LEVEL=INFO
DEBUG=true

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=krishisetu
POSTGRES_USER=krishisetu
# Generate a real password in prod:  openssl rand -hex 16
POSTGRES_PASSWORD=krishisetu_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# MinIO (S3-compatible object storage)
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=krishisetu
# Generate a real password in prod:  openssl rand -hex 16
MINIO_ROOT_PASSWORD=krishisetu_dev_password
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=krishisetu

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# JWT signing secret
# openssl rand -hex 32
JWT_SECRET=ac8800f3b46d086c37b2b47b23084b8a4483a829c241f62132dd94876aabc08a