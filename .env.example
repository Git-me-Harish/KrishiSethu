# KrishiSetu Root Environment
# Copy to .env and adjust as needed

ENV=development
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_DB=krishisetu
POSTGRES_USER=krishisetu
POSTGRES_PASSWORD=krishisetu_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=krishisetu
MINIO_ROOT_PASSWORD=krishisetu_dev_password
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=krishisetu

# API
API_HOST=0.0.0.0
API_PORT=8000

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
